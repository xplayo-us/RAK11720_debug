{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Debug RAK11720 (J-Link)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "jlink",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Hello_World.ino.elf",
            "device": "AMA3B1KK-KBR",
            "interface": "swd",
            "preLaunchTask": "Upload via SWD",
            "svdFile": "",
            "showDevDebugOutput": "raw",
            "postLaunchCommands": [
                "monitor reset halt",
                "load",
                "monitor reset",
                "continue"
            ],
            "swoConfig": {
                "enabled": false,
                "cpuFrequency": 48000000,
                "swoFrequency": 2000000,
                "source": "probe"
            }
        },
        {
            "name": "Attach to RAK11720 (J-Link)",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "jlink",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Hello_World.ino.elf",
            "device": "AMA3B1KK-KBR",
            "interface": "swd",
            "showDevDebugOutput": "raw"
        }
    ]
}