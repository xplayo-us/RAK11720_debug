{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug RAK11720 (J-Link)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "jlink",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/${workspaceFolderBasename}.ino.elf",
      "device": "AMA3B1KK-KBR",
      "interface": "swd",
      "preLaunchTask": "Upload via SWD",
      "showDevDebugOutput": "raw",
      "postLaunchCommands": [
        "monitor reset halt"
      ]
    },
    {
      "name": "Attach to RAK11720 (J-Link)",
      "type": "cortex-debug",
      "request": "attach",
      "servertype": "jlink",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/${workspaceFolderBasename}.ino.elf",
      "device": "AMA3B1KK-KBR",
      "interface": "swd",
      "showDevDebugOutput": "raw"
    }
  ]
}
